{
  "name": "kotodama-c11ertj5",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"createPo\",\"listPos\",\"getPo\",\"approvePo\",\"listSuppliers\",\"createSupplier\",\"recordReceipt\",\"listReceipts\"]",
    "APP_DESCRIPTION": "po — Purchase Order & Supply Chain Platform. BPMN-driven PO management with supplier registry and receipt tracking.",
    "APP_DISPLAY_NAME": "Purchase Orders",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "c11ertj5",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "c11ertj5.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "po.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
