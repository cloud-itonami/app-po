{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:po.etzhayyim.com",
  "name": "po",
  "nanoid": "c11ertj5",
  "project": "po",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "yoro",
  "accent": "#f59e0b",
  "convoSystemPrompt": "You are the purchase order and supply chain agent. You manage purchase orders, supplier registrations, approvals, and goods receipts.",
  "profile": {
    "displayName": "Purchase Orders",
    "description": "po — Purchase Order & Supply Chain Platform. BPMN-driven PO management with supplier registry and receipt tracking.",
    "avatar": "📦",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "amanomibashira",
    "capabilities": ["createPo", "listPos", "getPo", "approvePo", "listSuppliers", "createSupplier", "recordReceipt", "listReceipts"],
    "protocols": ["xrpc", "mcp"]
  },
  "governance": {
    "raci": "responsible",
    "classification": "public"
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.po.purchaseOrder",
        "com.etzhayyim.apps.po.supplier"
      ]
    }
  }
